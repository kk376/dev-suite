#!/usr/bin/env python3
import subprocess
import os

try:
    # 1. Call GNOME Shell D-Bus SelectArea
    out = subprocess.check_output([
        'gdbus', 'call', '--session',
        '--dest', 'org.gnome.Shell.Screenshot',
        '--object-path', '/org/gnome/Shell/Screenshot',
        '--method', 'org.gnome.Shell.Screenshot.SelectArea'
    ]).decode().strip()

    # Output format: (x, y, width, height) e.g. (100, 200, 500, 400)
    out = out.strip('() \n')
    parts = [int(p.strip()) for p in out.split(',') if p.strip()]
    if len(parts) == 4:
        x, y, w, h = parts
        if w > 0 and h > 0:
            tmp_path = '/dev/shm/gnome_clipboard_shot.png'
            # 2. Capture area to RAM buffer
            subprocess.run([
                'gdbus', 'call', '--session',
                '--dest', 'org.gnome.Shell.Screenshot',
                '--object-path', '/org/gnome/Shell/Screenshot',
                '--method', 'org.gnome.Shell.Screenshot.ScreenshotArea',
                str(x), str(y), str(w), str(h), 'true', tmp_path
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            # 3. Copy to Wayland clipboard
            if os.path.exists(tmp_path):
                with open(tmp_path, 'rb') as f:
                    subprocess.run(['wl-copy', '--type', 'image/png'], stdin=f)
                os.remove(tmp_path)
except Exception:
    pass
